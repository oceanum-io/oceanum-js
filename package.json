{
  "name": "oceanum-js",
  "version": "0.4.1",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jsdom": "~27.2.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@oceanum/datamesh": "^0.5.1",
    "@oceanum/eidos": "^0.1.0",
    "@oceanum/layers": "^0.1.0"
  },
  "overrides": {
    "@luma.gl/webgl": "~9.2.6"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @oceanum/datamesh && npm run build -w @oceanum/eidos && npm run build -w @oceanum/layers",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "build:docs": "npm run build:docs --workspaces --if-present",
    "docs": "typedoc",
    "docs:serve": "typedoc --watch"
  }
}
